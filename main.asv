clc;
clear;
close all;

%{
* ctrl + f --> TODO! for coding;
* ctrl + f --> NOTE! something over which we must pay attention;
* ctrl + f --> ASSUMPTION! when assumptions are introduced;
* 
%}

% NOTE! Make sure to have exactly the same name of the folders and MATLAB
% scripts as the ones I have described

% Add the two directories paths
addpath('auxiliary external functions') % for auxiliary functions
addpath('utils') % for testing functions
% transmitter, channel and receiver folders have already the '+' before the
% name, acting as a package/namespace

%% TRANSMITTER PARAMATERS
% TX tuner delay: 1 microsecond, only when frequency changes
tunerDelay_s = 1e-6;
% Set the length of the packet in bits
packetLength = 1331; % bits
dutyCycle = 1; % percentage TX/RX
numBursts = 28;
% the sync and the reference bits remain fixed for all bursts
rng(1); % fixed seed to keep fixed only the two random variables below
syncReference  = randi([0 1], 48, 1);   % 48 synchronization bits
phaseReference = randi([0 1], 48, 1);   % 48 phase reference bits
rng('shuffle'); % set 'shuffle' to keep it random at each iteration, otherwise  
% e.g.: 4 allows to view some good MetricPlots
% Frequencies & RRC Parameters
fMin = 1435e6;
fMax = 1518e6;
numFrequencyChannels = 4;
rolloff = 0.35; % how much extra band we use for the RRC filter
filterSpan = 12; % RRC filter duration in symbols NOTE! the longer it lasts
% over time, the sharper it is over the frequencies.
% TLC formula for Symbol Rate: symbolRate = channelBandwidth/(1+rolloff)
symbolRate = ((fMax - fMin)/numFrequencyChannels)/(1 + rolloff);
samplesPerSymbol = 8; % number of samples per symbol
Fs = symbolRate * samplesPerSymbol; % sampling frequency, since we are 
% constructing the signal from the symbol to the the continuous time domain 
% we need more samples to represent one symbol.
cpLength = 10; % TODO! Must exceed the maximum channel delay in symbols
% adding the space for the cyclic prefix

cpLength = ceil(delay_max/(1/symbolRate));

%% CHANNEL PARAMETERS
% INTERFERERS
numInterferers = 0; % set the number of interferer nodes, NOTE! it 
% resembles an ALOHA network!
% BLANKING COMPENSATION
blankingPercentage = 0.0; % percentage with respect to the time 'txSignal' 
% representing the time occupied by the RX node while is transmitting

%% RECEIVER PARAMETERS
channelEstMargin = 2; % especially important for fractional delays, when 
% the significative energy of the channel symbol-spaced extends beyond the 
% prediction on the maximum delay

%% SIMULATION PARAMETERS
% amount of packet transmissions we want to simulate
metrics.packets = 1; % simulation cycles 33
% for storing values we use a MATLAB 'Structure'
metrics.finalEncodedPacketErroredBits = 0; % errored bits in the encoded 
% packets
metrics.finalOriginalPacketErroredBits = 0; % errored bits in the original 
% packets
metrics.lostBurst = 0; % number of bursts lost
metrics.packetCompletelyReconstructed = false(1, metrics.packets); % with 0 
% errored bits
metrics.errRMS_runs = zeros(1, metrics.packets); 
metrics.errMax_runs = zeros(1, metrics.packets);
metrics.SINR_runs = zeros(1, metrics.packets); % SINR linear
metrics.EbN0_linear_runs = zeros(1, metrics.packets); % E_b/N_0 linear
metrics.EVM_runs = zeros(numBursts, metrics.packets); % EVM percentage
show_metrics_plots = true; % whether to show the metric plots or not

%% SIMULATION LOOP
for i = 1:metrics.packets

    %% TRANSMITTER
    [packet, ... % original packet with random bits
     encodedPacket, ... % encoded packet above
     numEncodedBits,  ... % number of encoded bits due to Turbo Coding
     interleaverIndices, ... % for turbo decoder
     M, ... % modulation type
     bitsPerSymbol, ... 
     numPadBits8PSK, ... % padding bits for 8PSK
     symbolsPerBurst, ...
     symbolsPerBurstWithCP, ...
     modulatedBursts, ... % after 8PSK
     txSCFDEBursts, ... % after SCFDE
     frequencyChannels,...
     fCenter, ...
     relativeCarrierFrequencies, ... % equivalent baseband
     carrierForBurst, ... 
     burstTxTime, ...
     startTimes, ... % per burst
     txSignal, ... % FINAL TRANSMITTED SIGNAL
     numProtectedIndexBits, ...
     burstIndexCodebook, ...
     bitsPerBurst ...
    ] = transmitter.transmitter(...
     packetLength, ...
     numBursts, ... % how many bursts a packet is divided into
     syncReference, ... % fixed preamble above
     phaseReference, ... % fixed preamble above
     fMin, ... % lower boundary 
     fMax, ... % upper boundary 
     numFrequencyChannels, ... 
     rolloff, ... % RRC configuration
     filterSpan, ... % RRC configuration
     symbolRate, ...
     samplesPerSymbol, ...
     Fs, ... % sampling frequency
     cpLength, ... % Cyclic Prefix for SCFDE
     tunerDelay_s, ... % tuner delay for carriers
     dutyCycle ...
     );
      
    %% CHANNEL
    [blankingMask, ... % blanking mask TxRxN
     rxSignal, ... % FINAL SIGNAL IN RX
     rxSignalImpaired, ...
     rxSignalAtAntenna, ...
     rxSignalWithInterference, ...
     interferer_waveform, ...
     pathGains, ...
     pathDelays_s, ...
     delay_max ...
    ] = channel.channel(...
        txSignal, ... % signal in input
        numBursts, ...
        fMin, ...
        fMax, ...
        fCenter, ...
        carrierForBurst, ... % carrier frequencies per burst
        symbolRate, ...
        samplesPerSymbol, ...
        Fs, ...
        startTimes, ...
        symbolsPerBurstWithCP, ...
        txSCFDEBursts,  ...
        filterSpan, ...
        rolloff, ...
        numFrequencyChannels, ...
        numInterferers, ...
        blankingPercentage, ...
        tunerDelay_s, ...
        dutyCycle, ...
        burstTxTime ...
        );
    
    %% RECEIVER
    [errMax, ...
     errRMS, ...
     totalErroredBitsFromEncodedPacket, ... 
     totalErroredBitsFromOriginalPacket, ...
     burstDetected, ...
     numPilotSymbols, ...
     rxEqualizedBursts, ...
     H_est_bursts, ...
     vettore, ...           % diagnostic
     detections, ...        % diagnostic
     rxMatchedByChannel ... % diagnostic
    ] = receiver.receiver( ...
        rxSignal, ... % input signal
        blankingMask, ...
        numBursts, ...
        syncReference, ...
        phaseReference, ...
        cpLength, ...
        packet, ...
        encodedPacket, ...
        numEncodedBits, ...
        interleaverIndices, ...
        M, ...
        bitsPerSymbol, ...
        numPadBits8PSK, ...
        symbolsPerBurst, ...
        symbolsPerBurstWithCP, ...
        modulatedBursts, ...
        txSCFDEBursts, ...
        relativeCarrierFrequencies, ...    
        rolloff, ...
        filterSpan, ...
        symbolRate, ...
        samplesPerSymbol, ...
        Fs, ...
        show_metrics_plots, ...
        i, ...
        numProtectedIndexBits, ...
        burstIndexCodebook, ...
        delay_max, ...
        channelEstMargin ...
        );
    
    %% COMPUTE METRICS
    [sinr_linear, ... % SINR linear
     EbN0_linear, ... % E_b/N_0 linear
     evmPerBurst_percent ... % EVM percentage
    ] = CalculateMetrics.calculate_metrics( ... % static Class
        Fs, ...
        rxSignalImpaired, ...
        rxSignalAtAntenna, ...
        rxSignalWithInterference, ...
        interferer_waveform, ...
        packetLength, ...
        numBursts, ...
        burstDetected, ...
        modulatedBursts, ...
        numPilotSymbols, ...
        rxEqualizedBursts);

    %% UPDATE METRICS per Cycle
    if totalErroredBitsFromOriginalPacket == 0
        metrics.packetCompletelyReconstructed(i) = true;
    end    
    metrics.finalEncodedPacketErroredBits = ...
        metrics.finalEncodedPacketErroredBits + ...
            totalErroredBitsFromEncodedPacket;
    metrics.finalOriginalPacketErroredBits = ...
        metrics.finalOriginalPacketErroredBits + ...
            totalErroredBitsFromOriginalPacket;
    metrics.lostBurst = metrics.lostBurst + sum(~burstDetected);
    metrics.errRMS_runs(i) = errRMS;
    metrics.errMax_runs(i) = errMax;
    metrics.SINR_runs(i) = sinr_linear;
    metrics.EbN0_linear_runs(i) = EbN0_linear;
    metrics.EVM_runs(:,i) = evmPerBurst_percent;
   
    % Metric Plots outputted only for the first iteration over the first
    % packet
    if show_metrics_plots == true && i == 1
        MetricPlots.frame_plot(bitsPerBurst, ...
                               cpLength, ...
                               syncReference, ...
                               phaseReference, ...
                               numProtectedIndexBits, ...
                               M);               
        MetricPlots.channelTaps_plot(pathDelays_s, ...
                                     pathGains);
        MetricPlots.channel_estimate(H_est_bursts, ...
                                     startTimes, ...
                                     Fs, ...
                                     numPilotSymbols, ...
                                     samplesPerSymbol, ...
                                     pathGains, ...
                                     symbolsPerBurst, ...
                                     burstDetected)
    end
end

% MATLAB Structure, for displaying values, in the Report, using the
% function 'final_values' from the Static Class 'CalculateMetrics' acting 
% as a related-functions collector
metrics_calculated = CalculateMetrics.final_values(metrics, ...
                                numEncodedBits, packetLength, numBursts);


%% PRINT REPORT 
fprintf('=============================================================\n');
% title
fprintf('||                           REPORT                        ||\n'); 
fprintf('=============================================================\n');
%{
fprintf(['Max error over %d runs; after synchronizations, before ' ...
    'equalization: %.3e\n'], metrics.packets, metrics_calculated.errMax);
fprintf(['Mean RMS error over %d runs; after synchronizations, before ' ...
    ' equalization: %.3e\n'], metrics.packets, metrics_calculated.errRMS);
fprintf(['STD RMS error over %d runs; after synchronizations, before ' ...
' equalization: %.3e\n'], metrics.packets, metrics_calculated.errSTD_RMS);
%}
% div
fprintf('-------------------------------------------------------------\n'); 
fprintf('Simulation run over a total of packets         = %d\n', ...
    metrics.packets);
fprintf('Hard errors inferred from LLR sign             = %d\n', ...
                            metrics_calculated.finalEncodedBitErrors);
fprintf('Total final errored bits from original packets = %d\n', ...
                            metrics_calculated.finalOriginalBitErrors);
% div
fprintf('-------------------------------------------------------------\n'); 
fprintf('Signal-to-Interference-plus-Noise Ratio   = %.2f dB\n', ...
                            metrics_calculated.SINR);
fprintf('Error Vector Magnitude percentage         = %.2f%%\n', ...
                            metrics_calculated.EVM_pct);
fprintf('Error Vector Magnitude decibels           = %.2f dB\n', ...
                            metrics_calculated.EVM_dB);
fprintf('E_b/N_0 linear                            = %.2f\n', ...
    metrics_calculated.EbN0_linear);
fprintf('E_b/N_0 decibels                          = %.2f dB\n', ...
    metrics_calculated.EbN0_dB);
% div
fprintf('-------------------------------------------------------------\n');
fprintf('Total bursts erased                    = %d\n', ...
    metrics_calculated.lostBurst);
fprintf('Total packets completely reconstructed = %d\n', ...
                            metrics_calculated.ReconstructedPacket);
% div
fprintf('-------------------------------------------------------------\n'); 
fprintf('Bit Error Rate before decoding = %.2f%%\n', ...
                            metrics_calculated.BER_before_dec);
fprintf('Bit Error Rate after decoding  = %.2f%%\n', ...
                            metrics_calculated.BER_after_dec);
fprintf('Burst Loss Rate                = %.2f%%\n', ...
    metrics_calculated.BLR);
fprintf('Packet Error Rate              = %.2f%%\n', ...
    metrics_calculated.PER);
% report end
fprintf('=============================================================\n'); 


